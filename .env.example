# Public URL used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Admin authentication. Use a long, unique password and a random 32+ character secret.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Added automatically when a Vercel Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Optional fallback frame URL when Blob is not connected yet.
NEXT_PUBLIC_DEFAULT_FRAME_URL=
